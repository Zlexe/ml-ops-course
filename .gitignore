cat > .gitignore << 'EOF'
.venv/
__pycache__/
*.pyc
data/
mlruns/
models/
.env
.dvc/cache
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
EOF

cat > .env.example << 'EOF'
MODEL_PATH=models/model.joblib
MODEL_VERSION=v1.0.0
EOF

mkdir -p data/raw src/app configs tests models
cp /mnt/user-data/uploads/bank-full.csv data/raw/ 2>/dev/null || echo "Скопируйте bank-full.csv в data/raw/ вручную"

git add .
git status